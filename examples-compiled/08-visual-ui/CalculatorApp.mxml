<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Calculator - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var display: String = "0";
        @reactive var currentValue: Number = 0;
        @reactive var previousValue: Number = 0;
        @reactive var operation: String = "";
        @reactive var newNumber: Boolean = true;

        function pressNumber(num: String): void {
            if (newNumber) {
                display = num;
                newNumber = false;
            } else {
                display = display === "0" ? num : display + num;
            }
        }

        function pressOperator(op: String): void {
            const current = parseFloat(display);

            if (operation && !newNumber) {
                calculate();
            } else {
                previousValue = current;
            }

            operation = op;
            newNumber = true;
        }

        function calculate(): void {
            const current = parseFloat(display);
            var result: Number = 0;

            if (operation === "+") {
                result = previousValue + current;
            } else if (operation === "-") {
                result = previousValue - current;
            } else if (operation === "*") {
                result = previousValue * current;
            } else if (operation === "/") {
                result = current !== 0 ? previousValue / current : 0;
            } else {
                result = current;
            }

            display = String(result);
            previousValue = result;
            newNumber = true;
            operation = "";
        }

        function clear(): void {
            display = "0";
            currentValue = 0;
            previousValue = 0;
            operation = "";
            newNumber = true;
        }

        function toggleSign(): void {
            if (display !== "0") {
                display = display.startsWith("-") ? display.substring(1) : "-" + display;
            }
        }

        function percentage(): void {
            display = String(parseFloat(display) / 100);
        }

        function pressDecimal(): void {
            if (newNumber) {
                display = "0.";
                newNumber = false;
            } else if (display.indexOf(".") === -1) {
                display = display + ".";
            }
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./calculator-app.css');
    </fx:Style>

    <VBox styleClass="calc-container">
        <VBox styleClass="calculator">
            <Label text="{display}" styleClass="display" />

            <!-- Row 1: AC, +/-, %, ÷ -->
            <HBox styleClass="btn-row">
                <Button label="AC" click="{clear}" styleClass="calc-btn btn-gray" />
                <Button label="+/-" click="{toggleSign}" styleClass="calc-btn btn-gray" />
                <Button label="%" click="{percentage}" styleClass="calc-btn btn-gray" />
                <Button label="÷" click="{() => pressOperator('/')}" styleClass="calc-btn btn-orange" />
            </HBox>

            <!-- Row 2: 7, 8, 9, × -->
            <HBox styleClass="btn-row">
                <Button label="7" click="{() => pressNumber('7')}" styleClass="calc-btn" />
                <Button label="8" click="{() => pressNumber('8')}" styleClass="calc-btn" />
                <Button label="9" click="{() => pressNumber('9')}" styleClass="calc-btn" />
                <Button label="×" click="{() => pressOperator('*')}" styleClass="calc-btn btn-orange" />
            </HBox>

            <!-- Row 3: 4, 5, 6, - -->
            <HBox styleClass="btn-row">
                <Button label="4" click="{() => pressNumber('4')}" styleClass="calc-btn" />
                <Button label="5" click="{() => pressNumber('5')}" styleClass="calc-btn" />
                <Button label="6" click="{() => pressNumber('6')}" styleClass="calc-btn" />
                <Button label="-" click="{() => pressOperator('-')}" styleClass="calc-btn btn-orange" />
            </HBox>

            <!-- Row 4: 1, 2, 3, + -->
            <HBox styleClass="btn-row">
                <Button label="1" click="{() => pressNumber('1')}" styleClass="calc-btn" />
                <Button label="2" click="{() => pressNumber('2')}" styleClass="calc-btn" />
                <Button label="3" click="{() => pressNumber('3')}" styleClass="calc-btn" />
                <Button label="+" click="{() => pressOperator('+')}" styleClass="calc-btn btn-orange" />
            </HBox>

            <!-- Row 5: 0 (wide), ., = -->
            <HBox styleClass="btn-row">
                <Button label="0" click="{() => pressNumber('0')}" styleClass="calc-btn btn-zero" />
                <Button label="." click="{pressDecimal}" styleClass="calc-btn" />
                <Button label="=" click="{calculate}" styleClass="calc-btn btn-orange" />
            </HBox>
        </VBox>
    </VBox>

</Application>
