<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Weather - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var celsius: Number = 22;

        @computed var fahrenheit: Number {
            return Math.round((celsius * 9/5) + 32);
        }

        @computed var kelvin: Number {
            return Math.round((celsius + 273.15) * 10) / 10;
        }

        @computed var weatherEmoji: String {
            if (celsius < 0) return "❄️";
            if (celsius < 10) return "🥶";
            if (celsius < 18) return "🌤️";
            if (celsius < 25) return "☀️";
            if (celsius < 32) return "🌡️";
            return "🔥";
        }

        @computed var weatherText: String {
            if (celsius < 0) return "Freezing";
            if (celsius < 10) return "Cold";
            if (celsius < 18) return "Cool";
            if (celsius < 25) return "Pleasant";
            if (celsius < 32) return "Warm";
            return "Hot";
        }

        @computed var gradientColor: String {
            if (celsius < 0) return "#00b4db";
            if (celsius < 10) return "#48b1bf";
            if (celsius < 18) return "#56ab2f";
            if (celsius < 25) return "#f7971e";
            if (celsius < 32) return "#f12711";
            return "#c31432";
        }

        function setTemperature(value: Number): void {
            celsius = value;
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./temperature-app.css');
    </fx:Style>

    <VBox styleClass="temp-container">
        <VBox styleClass="temp-card">
            <!-- Weather Display -->
            <VBox styleClass="weather-display" backgroundColor="{gradientColor}">
                <Label text="{weatherEmoji}" styleClass="weather-emoji" />
                <Label text="{weatherText}" styleClass="weather-status" />
                <Label styleClass="temp-main">
                    <Label text="{celsius}" />
                    <Label text="°C" styleClass="temp-unit" />
                </Label>
            </VBox>

            <!-- Slider -->
            <VBox styleClass="slider-section">
                <HBox styleClass="slider-label">
                    <Label text="-20°C" />
                    <Label text="Adjust Temperature" />
                    <Label text="50°C" />
                </HBox>
                <TextInput type="range" min="-20" max="50" value="{celsius}"
                           styleClass="temp-slider" />
            </VBox>

            <!-- Conversions -->
            <HBox styleClass="conversions">
                <VBox styleClass="conversion-card">
                    <Label text="{celsius + '°'}" styleClass="conversion-value" />
                    <Label text="Celsius" styleClass="conversion-label" />
                </VBox>
                <VBox styleClass="conversion-card">
                    <Label text="{fahrenheit + '°'}" styleClass="conversion-value" />
                    <Label text="Fahrenheit" styleClass="conversion-label" />
                </VBox>
                <VBox styleClass="conversion-card">
                    <Label text="{kelvin}" styleClass="conversion-value" />
                    <Label text="Kelvin" styleClass="conversion-label" />
                </VBox>
            </HBox>

            <!-- Quick Temperature Buttons -->
            <HBox styleClass="quick-temps">
                <Button label="-10°" click="{() => setTemperature(-10)}" styleClass="quick-btn" />
                <Button label="0°" click="{() => setTemperature(0)}" styleClass="quick-btn" />
                <Button label="20°" click="{() => setTemperature(20)}" styleClass="quick-btn" />
                <Button label="37°" click="{() => setTemperature(37)}" styleClass="quick-btn" />
            </HBox>
        </VBox>
    </VBox>

</Application>
