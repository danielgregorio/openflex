<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Color Picker - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var red: Number = 88;
        @reactive var green: Number = 86;
        @reactive var blue: Number = 214;

        @computed var hexColor: String {
            const toHex = (n) => {
                const hex = Math.round(n).toString(16);
                return hex.length === 1 ? "0" + hex : hex;
            };
            return "#" + toHex(red) + toHex(green) + toHex(blue);
        }

        @computed var rgbColor: String {
            return Math.round(red) + ", " + Math.round(green) + ", " + Math.round(blue);
        }

        @computed var brightness: Number {
            return (red * 0.299 + green * 0.587 + blue * 0.114) / 255;
        }

        @computed var textColor: String {
            return brightness > 0.5 ? "#000000" : "#ffffff";
        }

        function randomColor(): void {
            red = Math.floor(Math.random() * 256);
            green = Math.floor(Math.random() * 256);
            blue = Math.floor(Math.random() * 256);
        }

        function setPreset(r: Number, g: Number, b: Number): void {
            red = r;
            green = g;
            blue = b;
        }

        function copyHex(): void {
            navigator.clipboard.writeText(hexColor.toUpperCase());
        }

        function copyRgb(): void {
            navigator.clipboard.writeText("rgb(" + rgbColor + ")");
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./color-picker-app.css');
    </fx:Style>

    <VBox styleClass="picker-container">
        <VBox styleClass="picker-card">
            <!-- Color Preview -->
            <VBox styleClass="color-preview" backgroundColor="{hexColor}">
                <Label text="{hexColor.toUpperCase()}" styleClass="preview-hex" color="{textColor}" />
                <Label text="{'RGB(' + rgbColor + ')'}" styleClass="preview-rgb" color="{textColor}" />
            </VBox>

            <!-- RGB Sliders -->
            <VBox styleClass="sliders-section">
                <VBox styleClass="slider-row">
                    <HBox styleClass="slider-header">
                        <Label text="Red" styleClass="slider-label" />
                        <Label text="{Math.round(red)}" styleClass="slider-value" />
                    </HBox>
                    <TextInput type="range" min="0" max="255" value="{red}"
                               styleClass="color-slider slider-red" />
                </VBox>

                <VBox styleClass="slider-row">
                    <HBox styleClass="slider-header">
                        <Label text="Green" styleClass="slider-label" />
                        <Label text="{Math.round(green)}" styleClass="slider-value" />
                    </HBox>
                    <TextInput type="range" min="0" max="255" value="{green}"
                               styleClass="color-slider slider-green" />
                </VBox>

                <VBox styleClass="slider-row">
                    <HBox styleClass="slider-header">
                        <Label text="Blue" styleClass="slider-label" />
                        <Label text="{Math.round(blue)}" styleClass="slider-value" />
                    </HBox>
                    <TextInput type="range" min="0" max="255" value="{blue}"
                               styleClass="color-slider slider-blue" />
                </VBox>
            </VBox>

            <!-- Actions -->
            <VBox styleClass="actions-section">
                <HBox styleClass="copy-row">
                    <Button label="Copy HEX" click="{copyHex}" styleClass="copy-btn" />
                    <Button label="Copy RGB" click="{copyRgb}" styleClass="copy-btn" />
                </HBox>
                <Button label="Random Color" click="{randomColor}" styleClass="random-btn" />
            </VBox>

            <!-- Presets -->
            <VBox styleClass="presets-section">
                <Label text="Presets" styleClass="presets-label" />
                <HBox styleClass="presets-row">
                    <Button click="{() => setPreset(255, 59, 48)}"
                            styleClass="preset-btn" backgroundColor="#ff3b30" />
                    <Button click="{() => setPreset(255, 149, 0)}"
                            styleClass="preset-btn" backgroundColor="#ff9500" />
                    <Button click="{() => setPreset(52, 199, 89)}"
                            styleClass="preset-btn" backgroundColor="#34c759" />
                    <Button click="{() => setPreset(0, 122, 255)}"
                            styleClass="preset-btn" backgroundColor="#007aff" />
                    <Button click="{() => setPreset(88, 86, 214)}"
                            styleClass="preset-btn" backgroundColor="#5856d6" />
                    <Button click="{() => setPreset(175, 82, 222)}"
                            styleClass="preset-btn" backgroundColor="#af52de" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>

</Application>
