<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Stopwatch - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var milliseconds: Number = 0;
        @reactive var isRunning: Boolean = false;
        @reactive var intervalId: Number = 0;
        @reactive var laps: Array = [];

        @computed var displayTime: String {
            const totalSeconds = Math.floor(milliseconds / 1000);
            const mins = Math.floor(totalSeconds / 60);
            const secs = totalSeconds % 60;
            const ms = Math.floor((milliseconds % 1000) / 10);

            const pad = (n) => String(n).padStart(2, '0');
            return pad(mins) + ":" + pad(secs) + "." + pad(ms);
        }

        @computed var hasTime: Boolean {
            return milliseconds > 0;
        }

        @computed var canReset: Boolean {
            return hasTime && !isRunning;
        }

        function start(): void {
            if (!isRunning) {
                intervalId = setInterval(() => {
                    milliseconds += 10;
                }, 10);
                isRunning = true;
            }
        }

        function stop(): void {
            if (isRunning) {
                clearInterval(intervalId);
                isRunning = false;
            }
        }

        function reset(): void {
            stop();
            milliseconds = 0;
            laps = [];
        }

        function lap(): void {
            if (isRunning && milliseconds > 0) {
                laps = [displayTime, ...laps];
            }
        }

        function handleLeftButton(): void {
            if (canReset) {
                reset();
            } else {
                lap();
            }
        }

        function handleRightButton(): void {
            if (isRunning) {
                stop();
            } else {
                start();
            }
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./timer-app.css');
    </fx:Style>

    <VBox styleClass="timer-container">
        <VBox styleClass="timer">
            <Label text="{displayTime}" styleClass="display" />

            <HBox styleClass="btn-row">
                <Button label="{canReset ? 'Reset' : 'Lap'}"
                        click="{handleLeftButton}"
                        styleClass="timer-btn {canReset ? 'btn-reset' : 'btn-lap'}" />
                <Button label="{isRunning ? 'Stop' : 'Start'}"
                        click="{handleRightButton}"
                        styleClass="timer-btn {isRunning ? 'btn-stop' : 'btn-start'}" />
            </HBox>

            <VBox styleClass="lap-list" visible="{laps.length > 0}">
                <Repeater dataProvider="{laps}">
                    <HBox styleClass="lap-item">
                        <Label text="{'Lap ' + (laps.length - index)}" styleClass="lap-number" />
                        <Label text="{item}" />
                    </HBox>
                </Repeater>
            </VBox>
        </VBox>
    </VBox>

</Application>
