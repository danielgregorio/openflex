<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Counter - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var count: Number = 0;

        @computed var countColor: String {
            if (count > 0) return "#34c759";
            if (count < 0) return "#ff3b30";
            return "#ffffff";
        }

        @computed var statusIcon: String {
            if (count > 0) return "+";
            if (count < 0) return "";
            return "";
        }

        function increment(): void {
            count++;
        }

        function decrement(): void {
            count--;
        }

        function reset(): void {
            count = 0;
        }

        function add10(): void {
            count += 10;
        }

        function subtract10(): void {
            count -= 10;
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./counter-app.css');
    </fx:Style>

    <VBox styleClass="counter-container">
        <VBox styleClass="counter">
            <Label text="{statusIcon + count}" styleClass="display" color="{countColor}" />

            <!-- Row 1: -10, Reset, +10 -->
            <HBox styleClass="btn-row">
                <Button label="-10" click="{subtract10}" styleClass="counter-btn btn-gray" />
                <Button label="AC" click="{reset}" styleClass="counter-btn btn-orange" />
                <Button label="+10" click="{add10}" styleClass="counter-btn btn-gray" />
            </HBox>

            <!-- Row 2: Decrement, Increment -->
            <HBox styleClass="btn-row">
                <Button label="-" click="{decrement}" styleClass="counter-btn btn-wide btn-red" />
                <Button label="+" click="{increment}" styleClass="counter-btn btn-wide btn-green" />
            </HBox>

            <Label text="Tap buttons to change value" styleClass="status-label" />
        </VBox>
    </VBox>

</Application>
