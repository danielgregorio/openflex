<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Sign Up - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var fullName: String = "";
        @reactive var email: String = "";
        @reactive var password: String = "";
        @reactive var confirmPassword: String = "";
        @reactive var agreeTerms: Boolean = false;
        @reactive var submitted: Boolean = false;
        @reactive var nameTouched: Boolean = false;
        @reactive var emailTouched: Boolean = false;
        @reactive var passwordTouched: Boolean = false;
        @reactive var confirmTouched: Boolean = false;

        @computed var isNameValid: Boolean {
            return fullName.trim().length >= 2;
        }

        @computed var isEmailValid: Boolean {
            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return regex.test(email);
        }

        @computed var isPasswordValid: Boolean {
            return password.length >= 8;
        }

        @computed var doPasswordsMatch: Boolean {
            return password === confirmPassword && confirmPassword.length > 0;
        }

        @computed var isFormValid: Boolean {
            return isNameValid && isEmailValid && isPasswordValid && doPasswordsMatch && agreeTerms;
        }

        @computed var showNameError: Boolean {
            return nameTouched && !isNameValid;
        }

        @computed var showEmailError: Boolean {
            return emailTouched && !isEmailValid;
        }

        @computed var showConfirmError: Boolean {
            return confirmTouched && !doPasswordsMatch;
        }

        @computed var nameInputClass: String {
            if (!nameTouched) return 'form-input';
            return isNameValid ? 'form-input input-valid' : 'form-input input-invalid';
        }

        @computed var emailInputClass: String {
            if (!emailTouched) return 'form-input';
            return isEmailValid ? 'form-input input-valid' : 'form-input input-invalid';
        }

        @computed var passwordInputClass: String {
            if (!passwordTouched) return 'form-input';
            return isPasswordValid ? 'form-input input-valid' : 'form-input input-invalid';
        }

        @computed var confirmInputClass: String {
            if (!confirmTouched) return 'form-input';
            return doPasswordsMatch ? 'form-input input-valid' : 'form-input input-invalid';
        }

        @computed var passwordStrength: String {
            if (password.length === 0) return "none";
            if (password.length < 6) return "weak";
            if (password.length < 10) return "medium";
            return "strong";
        }

        @computed var strengthLabel: String {
            if (passwordStrength === "weak") return "Weak";
            if (passwordStrength === "medium") return "Medium";
            if (passwordStrength === "strong") return "Strong";
            return "";
        }

        @computed var strengthColor: String {
            if (passwordStrength === "weak") return "#ff3b30";
            if (passwordStrength === "medium") return "#ff9500";
            if (passwordStrength === "strong") return "#34c759";
            return "#3a3a3c";
        }

        @computed var showStrength: Boolean {
            return password.length > 0;
        }

        @computed var bar1Color: String {
            return password.length >= 1 ? strengthColor : "#3a3a3c";
        }

        @computed var bar2Color: String {
            return password.length >= 6 ? strengthColor : "#3a3a3c";
        }

        @computed var bar3Color: String {
            return password.length >= 10 ? strengthColor : "#3a3a3c";
        }

        function submitForm(): void {
            if (!isFormValid) return;
            submitted = true;
        }

        function goBack(): void {
            submitted = false;
            fullName = "";
            email = "";
            password = "";
            confirmPassword = "";
            agreeTerms = false;
            nameTouched = false;
            emailTouched = false;
            passwordTouched = false;
            confirmTouched = false;
        }

        function toggleTerms(): void {
            agreeTerms = !agreeTerms;
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./form-app.css');
    </fx:Style>

    <VBox styleClass="form-container">
        <!-- Sign Up Form -->
        <VBox styleClass="form-card" visible="{!submitted}">
            <VBox styleClass="form-header">
                <Label text="Create Account" styleClass="form-title" />
                <Label text="Sign up to get started" styleClass="form-subtitle" />
            </VBox>

            <VBox styleClass="form-body">
                <!-- Full Name -->
                <VBox styleClass="input-group">
                    <Label text="Full Name" styleClass="input-label" />
                    <TextInput placeholder="John Doe"
                               value="{fullName}"
                               blur="{() => nameTouched = true}"
                               styleClass="{nameInputClass}" />
                    <Label text="Name must be at least 2 characters"
                           styleClass="error-text"
                           visible="{showNameError}" />
                </VBox>

                <!-- Email -->
                <VBox styleClass="input-group">
                    <Label text="Email Address" styleClass="input-label" />
                    <TextInput type="email"
                               placeholder="john@example.com"
                               value="{email}"
                               blur="{() => emailTouched = true}"
                               styleClass="{emailInputClass}" />
                    <Label text="Please enter a valid email address"
                           styleClass="error-text"
                           visible="{showEmailError}" />
                </VBox>

                <!-- Password -->
                <VBox styleClass="input-group">
                    <Label text="Password" styleClass="input-label" />
                    <TextInput type="password"
                               placeholder="At least 8 characters"
                               value="{password}"
                               blur="{() => passwordTouched = true}"
                               styleClass="{passwordInputClass}" />
                    <HBox styleClass="password-strength" visible="{showStrength}">
                        <Box styleClass="strength-bar" backgroundColor="{bar1Color}" />
                        <Box styleClass="strength-bar" backgroundColor="{bar2Color}" />
                        <Box styleClass="strength-bar" backgroundColor="{bar3Color}" />
                        <Label text="{strengthLabel}" styleClass="strength-label" color="{strengthColor}" />
                    </HBox>
                </VBox>

                <!-- Confirm Password -->
                <VBox styleClass="input-group">
                    <Label text="Confirm Password" styleClass="input-label" />
                    <TextInput type="password"
                               placeholder="Repeat your password"
                               value="{confirmPassword}"
                               blur="{() => confirmTouched = true}"
                               styleClass="{confirmInputClass}" />
                    <Label text="Passwords do not match"
                           styleClass="error-text"
                           visible="{showConfirmError}" />
                </VBox>

                <!-- Terms Checkbox -->
                <HBox styleClass="checkbox-row">
                    <Button label="{agreeTerms ? '✓' : ''}"
                            click="{toggleTerms}"
                            styleClass="checkbox-custom {agreeTerms ? 'checkbox-checked' : ''}" />
                    <Label text="I agree to the Terms and Privacy Policy" styleClass="checkbox-label" />
                </HBox>

                <!-- Submit -->
                <Button label="Create Account"
                        click="{submitForm}"
                        disabled="{!isFormValid}"
                        styleClass="submit-btn" />
            </VBox>
        </VBox>

        <!-- Success State -->
        <VBox styleClass="form-card" visible="{submitted}">
            <VBox styleClass="success-content">
                <Label text="🎉" styleClass="success-icon" />
                <Label text="Welcome Aboard!" styleClass="success-title" />
                <Label text="{'Your account has been created successfully. Welcome, ' + fullName + '!'}"
                       styleClass="success-text" />
                <Button label="Back to Form" click="{goBack}" styleClass="back-btn" />
            </VBox>
        </VBox>
    </VBox>

</Application>
