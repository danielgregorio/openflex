<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Formulário de Contato - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var name: String = "";
        @reactive var email: String = "";
        @reactive var message: String = "";
        @reactive var subscribe: Boolean = false;
        @reactive var submitted: Boolean = false;

        @computed var isNameValid: Boolean {
            return name.trim().length >= 3;
        }

        @computed var isEmailValid: Boolean {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }

        @computed var isMessageValid: Boolean {
            return message.trim().length >= 10;
        }

        @computed var isFormValid: Boolean {
            return isNameValid && isEmailValid && isMessageValid;
        }

        @computed var nameError: String {
            if (name.length === 0) return "";
            return isNameValid ? "" : "Nome deve ter pelo menos 3 caracteres";
        }

        @computed var emailError: String {
            if (email.length === 0) return "";
            return isEmailValid ? "" : "Email inválido";
        }

        @computed var messageError: String {
            if (message.length === 0) return "";
            return isMessageValid ? "" : "Mensagem deve ter pelo menos 10 caracteres";
        }

        function submitForm(): void {
            if (!isFormValid) return;

            // Simular envio
            console.log("Enviando formulário:", { name, email, message, subscribe });
            submitted = true;

            // Reset após 3 segundos
            setTimeout(() => {
                submitted = false;
                name = "";
                email = "";
                message = "";
                subscribe = false;
            }, 3000);
        }

        function resetForm(): void {
            name = "";
            email = "";
            message = "";
            subscribe = false;
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('../runtime/neo-flex-classic-theme.css');

        .form-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-size: 14px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            font-size: 16px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .form-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .form-input-error {
            border-color: #e74c3c;
        }

        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            font-size: 16px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            min-height: 120px;
            resize: vertical;
            font-family: inherit;
        }

        .error-message {
            font-size: 12px;
            color: #e74c3c;
            margin-top: 5px;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .submit-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 40px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .submit-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .reset-btn {
            background: transparent;
            color: #7f8c8d;
            padding: 12px 30px;
            font-size: 16px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .success-message {
            background: #27ae60;
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
    </fx:Style>

    <VBox gap="{20}" horizontalAlign="center" verticalAlign="middle" width="100%" height="100%"
          style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

        <Box styleClass="form-container" visible="{!submitted}">
            <VBox gap="{25}">
                <Label text="📝 Formulário de Contato" fontSize="{32}" fontWeight="bold" textAlign="center" />

                <VBox gap="{5}" styleClass="form-group">
                    <Label text="Nome" styleClass="form-label" />
                    <TextInput type="text" placeholder="Digite seu nome completo"
                               value="{name}"
                               styleClass="{'form-input ' + (nameError ? 'form-input-error' : '')}" />
                    <Label text="{nameError}" styleClass="error-message" visible="{nameError.length > 0}" />
                </VBox>

                <VBox gap="{5}" styleClass="form-group">
                    <Label text="Email" styleClass="form-label" />
                    <TextInput type="email" placeholder="seu@email.com"
                               value="{email}"
                               styleClass="{'form-input ' + (emailError ? 'form-input-error' : '')}" />
                    <Label text="{emailError}" styleClass="error-message" visible="{emailError.length > 0}" />
                </VBox>

                <VBox gap="{5}" styleClass="form-group">
                    <Label text="Mensagem" styleClass="form-label" />
                    <TextInput type="textarea" placeholder="Digite sua mensagem aqui..."
                               value="{message}"
                               styleClass="{'form-textarea ' + (messageError ? 'form-input-error' : '')}" />
                    <Label text="{messageError}" styleClass="error-message" visible="{messageError.length > 0}" />
                </VBox>

                <HBox gap="{10}" styleClass="checkbox-container">
                    <CheckBox checked="{subscribe}" />
                    <Label text="Quero receber novidades por email" fontSize="{14}" />
                </HBox>

                <VBox gap="{10}">
                    <Button label="📨 Enviar Mensagem"
                            click="{submitForm}"
                            styleClass="submit-btn"
                            disabled="{!isFormValid}" />
                    <Button label="🔄 Limpar Formulário"
                            click="{resetForm}"
                            styleClass="reset-btn" />
                </VBox>

                <Label text="{'Campos preenchidos: ' + (isNameValid ? '✅' : '❌') + ' Nome | ' + (isEmailValid ? '✅' : '❌') + ' Email | ' + (isMessageValid ? '✅' : '❌') + ' Mensagem'}"
                       fontSize="{12}" color="#7f8c8d" textAlign="center" />
            </VBox>
        </Box>

        <Box styleClass="form-container" visible="{submitted}">
            <VBox gap="{30}" horizontalAlign="center">
                <Label text="✅ Mensagem Enviada!" fontSize="{32}" fontWeight="bold" />
                <Label text="Obrigado pelo contato! Responderemos em breve." fontSize="{18}" textAlign="center" />
                <Label text="Este formulário será resetado automaticamente..." fontSize="{14}" color="#7f8c8d" />
            </VBox>
        </Box>

    </VBox>

</Application>
