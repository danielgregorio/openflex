<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Quiz Interativo - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var currentQuestion: Number = 0;
        @reactive var score: Number = 0;
        @reactive var showResult: Boolean = false;
        @reactive var selectedAnswer: Number = -1;

        const questions: Array = [
            {
                question: "Qual é a capital do Brasil?",
                answers: ["São Paulo", "Rio de Janeiro", "Brasília", "Salvador"],
                correct: 2
            },
            {
                question: "Quantos planetas existem no Sistema Solar?",
                answers: ["7", "8", "9", "10"],
                correct: 1
            },
            {
                question: "Quem pintou a Mona Lisa?",
                answers: ["Van Gogh", "Da Vinci", "Picasso", "Monet"],
                correct: 1
            },
            {
                question: "Qual é o maior oceano do mundo?",
                answers: ["Atlântico", "Índico", "Ártico", "Pacífico"],
                correct: 3
            },
            {
                question: "Em que ano o homem pisou na Lua pela primeira vez?",
                answers: ["1965", "1967", "1969", "1971"],
                correct: 2
            }
        ];

        @computed var progress: Number {
            return (currentQuestion / questions.length) * 100;
        }

        @computed var currentQ: Object {
            return questions[currentQuestion] || {};
        }

        function selectAnswer(index: Number): void {
            selectedAnswer = index;
        }

        function nextQuestion(): void {
            if (selectedAnswer === -1) return;

            if (selectedAnswer === currentQ.correct) {
                score++;
            }

            selectedAnswer = -1;

            if (currentQuestion < questions.length - 1) {
                currentQuestion++;
            } else {
                showResult = true;
            }
        }

        function restart(): void {
            currentQuestion = 0;
            score = 0;
            showResult = false;
            selectedAnswer = -1;
        }

        @computed var scorePercentage: Number {
            return Math.round((score / questions.length) * 100);
        }

        @computed var resultMessage: String {
            if (scorePercentage >= 80) return "Excelente! 🎉";
            if (scorePercentage >= 60) return "Muito bom! 👏";
            if (scorePercentage >= 40) return "Bom trabalho! 👍";
            return "Continue praticando! 💪";
        }
    ]]></fx:Script>

    <fx:Style>
        .quiz-container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
        }

        .progress-bar {
            height: 10px;
            background: #ecf0f1;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: width 0.3s ease;
        }

        .question-text {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            text-align: center;
        }

        .answer-btn {
            width: 100%;
            padding: 20px;
            font-size: 18px;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
            text-align: left;
        }

        .answer-btn:hover {
            border-color: #667eea;
            background: #f8f9fa;
            transform: translateX(5px);
        }

        .answer-btn-selected {
            border-color: #667eea;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .next-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 50px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        .score-display {
            font-size: 72px;
            font-weight: bold;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </fx:Style>

    <VBox gap="{20}" horizontalAlign="center" verticalAlign="middle" width="100%" height="100%"
          style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

        <Box styleClass="quiz-container" visible="{!showResult}">
            <VBox gap="{30}">
                <VBox gap="{10}">
                    <Label text="{'Questão ' + (currentQuestion + 1) + ' de ' + questions.length}"
                           fontSize="{14}" color="#7f8c8d" />
                    <Box styleClass="progress-bar">
                        <Box styleClass="progress-fill" width="{progress + '%'}" />
                    </Box>
                </VBox>

                <Label text="{currentQ.question}" styleClass="question-text" />

                <VBox gap="{15}">
                    <Button label="{'A) ' + currentQ.answers[0]}"
                            click="{() => selectAnswer(0)}"
                            styleClass="{'answer-btn ' + (selectedAnswer === 0 ? 'answer-btn-selected' : '')}" />
                    <Button label="{'B) ' + currentQ.answers[1]}"
                            click="{() => selectAnswer(1)}"
                            styleClass="{'answer-btn ' + (selectedAnswer === 1 ? 'answer-btn-selected' : '')}" />
                    <Button label="{'C) ' + currentQ.answers[2]}"
                            click="{() => selectAnswer(2)}"
                            styleClass="{'answer-btn ' + (selectedAnswer === 2 ? 'answer-btn-selected' : '')}" />
                    <Button label="{'D) ' + currentQ.answers[3]}"
                            click="{() => selectAnswer(3)}"
                            styleClass="{'answer-btn ' + (selectedAnswer === 3 ? 'answer-btn-selected' : '')}" />
                </VBox>

                <HBox horizontalAlign="center">
                    <Button label="Próxima →" click="{nextQuestion}" styleClass="next-btn" />
                </HBox>
            </VBox>
        </Box>

        <Box styleClass="quiz-container" visible="{showResult}">
            <VBox gap="{30}" horizontalAlign="center">
                <Label text="🎯 Resultado Final" fontSize="{32}" fontWeight="bold" />

                <Label text="{scorePercentage + '%'}" styleClass="score-display" />

                <Label text="{resultMessage}" fontSize="{28}" fontWeight="bold" color="#2c3e50" />

                <Label text="{'Você acertou ' + score + ' de ' + questions.length + ' questões'}"
                       fontSize="{18}" color="#7f8c8d" />

                <Button label="🔄 Jogar Novamente" click="{restart}" styleClass="next-btn" />
            </VBox>
        </Box>

    </VBox>

</Application>
