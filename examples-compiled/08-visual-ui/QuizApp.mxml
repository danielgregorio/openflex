<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Quiz - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var currentQuestion: Number = 0;
        @reactive var score: Number = 0;
        @reactive var showResult: Boolean = false;
        @reactive var selectedAnswer: Number = -1;
        @reactive var answered: Boolean = false;

        const questions: Array = [
            {
                question: "What is the capital of France?",
                answers: ["London", "Berlin", "Paris", "Madrid"],
                correct: 2
            },
            {
                question: "Which planet is known as the Red Planet?",
                answers: ["Venus", "Mars", "Jupiter", "Saturn"],
                correct: 1
            },
            {
                question: "What year did the first iPhone launch?",
                answers: ["2005", "2006", "2007", "2008"],
                correct: 2
            },
            {
                question: "Who painted the Mona Lisa?",
                answers: ["Van Gogh", "Picasso", "Da Vinci", "Monet"],
                correct: 2
            },
            {
                question: "What is the largest ocean on Earth?",
                answers: ["Atlantic", "Indian", "Arctic", "Pacific"],
                correct: 3
            }
        ];

        @computed var progress: Number {
            return ((currentQuestion + 1) / questions.length) * 100;
        }

        @computed var currentQ: Object {
            return questions[currentQuestion] || {};
        }

        @computed var scorePercentage: Number {
            return Math.round((score / questions.length) * 100);
        }

        @computed var resultEmoji: String {
            if (scorePercentage >= 80) return "🏆";
            if (scorePercentage >= 60) return "🎉";
            if (scorePercentage >= 40) return "👍";
            return "📚";
        }

        function selectAnswer(index: Number): void {
            if (answered) return;
            selectedAnswer = index;
            answered = true;
            if (index === currentQ.correct) {
                score++;
            }
        }

        function nextQuestion(): void {
            if (!answered) return;
            selectedAnswer = -1;
            answered = false;
            if (currentQuestion < questions.length - 1) {
                currentQuestion++;
            } else {
                showResult = true;
            }
        }

        function restart(): void {
            currentQuestion = 0;
            score = 0;
            showResult = false;
            selectedAnswer = -1;
            answered = false;
        }

        function getAnswerStyle(index: Number): String {
            if (!answered) {
                return selectedAnswer === index ? 'answer-selected' : '';
            }
            if (index === currentQ.correct) return 'answer-correct';
            if (index === selectedAnswer) return 'answer-wrong';
            return 'answer-disabled';
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./quiz-app.css');
    </fx:Style>

    <VBox styleClass="quiz-container">
        <!-- Quiz Card -->
        <VBox styleClass="quiz-card" visible="{!showResult}">
            <!-- Progress -->
            <VBox styleClass="progress-section">
                <Label text="{'Question ' + (currentQuestion + 1) + ' of ' + questions.length}"
                       styleClass="progress-text" />
                <Box styleClass="progress-bar">
                    <Box styleClass="progress-fill" width="{progress + '%'}" />
                </Box>
            </VBox>

            <!-- Question -->
            <VBox styleClass="question-section">
                <Label text="{currentQ.question}" styleClass="question-text" />
            </VBox>

            <!-- Answers -->
            <VBox styleClass="answers-section">
                <Button label="{currentQ.answers[0]}"
                        click="{() => selectAnswer(0)}"
                        styleClass="answer-btn {getAnswerStyle(0)}" />
                <Button label="{currentQ.answers[1]}"
                        click="{() => selectAnswer(1)}"
                        styleClass="answer-btn {getAnswerStyle(1)}" />
                <Button label="{currentQ.answers[2]}"
                        click="{() => selectAnswer(2)}"
                        styleClass="answer-btn {getAnswerStyle(2)}" />
                <Button label="{currentQ.answers[3]}"
                        click="{() => selectAnswer(3)}"
                        styleClass="answer-btn {getAnswerStyle(3)}" />
            </VBox>

            <!-- Next Button -->
            <VBox styleClass="next-section">
                <Button label="{currentQuestion === questions.length - 1 ? 'See Results' : 'Next Question'}"
                        click="{nextQuestion}"
                        styleClass="next-btn {!answered ? 'next-btn-disabled' : ''}" />
            </VBox>
        </VBox>

        <!-- Result Card -->
        <VBox styleClass="quiz-card" visible="{showResult}">
            <VBox styleClass="result-section">
                <Label text="{resultEmoji}" styleClass="result-emoji" />
                <Label text="Quiz Complete!" styleClass="result-title" />
                <Label text="{scorePercentage + '%'}" styleClass="result-score" />
                <Label text="{'You got ' + score + ' out of ' + questions.length + ' correct'}"
                       styleClass="result-detail" />
                <Button label="Play Again" click="{restart}" styleClass="next-btn" />
            </VBox>
        </VBox>
    </VBox>

</Application>
