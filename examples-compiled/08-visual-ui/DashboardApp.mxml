<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Dashboard - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var revenue: Number = 48250;
        @reactive var users: Number = 2847;
        @reactive var orders: Number = 384;
        @reactive var conversion: Number = 3.24;

        @reactive var revenueChange: Number = 12.5;
        @reactive var usersChange: Number = 8.2;
        @reactive var ordersChange: Number = -2.4;
        @reactive var conversionChange: Number = 0.8;

        @computed var revenueFormatted: String {
            return "$" + revenue.toLocaleString();
        }

        @computed var usersFormatted: String {
            return users.toLocaleString();
        }

        @computed var ordersFormatted: String {
            return orders.toLocaleString();
        }

        @computed var conversionFormatted: String {
            return conversion.toFixed(2) + "%";
        }

        @computed var revenueChangeText: String {
            return formatChange(revenueChange);
        }

        @computed var usersChangeText: String {
            return formatChange(usersChange);
        }

        @computed var ordersChangeText: String {
            return formatChange(ordersChange);
        }

        @computed var conversionChangeText: String {
            return formatChange(conversionChange);
        }

        @computed var revenueChangeColor: String {
            return getChangeColor(revenueChange);
        }

        @computed var usersChangeColor: String {
            return getChangeColor(usersChange);
        }

        @computed var ordersChangeColor: String {
            return getChangeColor(ordersChange);
        }

        @computed var conversionChangeColor: String {
            return getChangeColor(conversionChange);
        }

        @computed var revenueChangeClass: String {
            return revenueChange >= 0 ? 'card-change' : 'card-change change-negative';
        }

        @computed var usersChangeClass: String {
            return usersChange >= 0 ? 'card-change' : 'card-change change-negative';
        }

        @computed var ordersChangeClass: String {
            return ordersChange >= 0 ? 'card-change' : 'card-change change-negative';
        }

        @computed var conversionChangeClass: String {
            return conversionChange >= 0 ? 'card-change' : 'card-change change-negative';
        }

        function formatChange(value: Number): String {
            const prefix = value >= 0 ? "+" : "";
            return prefix + value.toFixed(1) + "%";
        }

        function getChangeColor(value: Number): String {
            return value >= 0 ? "#34c759" : "#ff3b30";
        }

        function refreshData(): void {
            revenue = Math.floor(40000 + Math.random() * 20000);
            users = Math.floor(2000 + Math.random() * 2000);
            orders = Math.floor(300 + Math.random() * 200);
            conversion = 2 + Math.random() * 3;

            revenueChange = -5 + Math.random() * 20;
            usersChange = -5 + Math.random() * 20;
            ordersChange = -5 + Math.random() * 10;
            conversionChange = -2 + Math.random() * 4;
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./dashboard-app.css');
    </fx:Style>

    <VBox styleClass="dashboard-container">
        <VBox styleClass="dashboard-wrapper">
            <!-- Header -->
            <HBox styleClass="dashboard-header">
                <VBox>
                    <Label text="Dashboard" styleClass="header-title" />
                    <Label text="Overview of your business metrics" styleClass="header-subtitle" />
                </VBox>
                <Button label="Refresh" click="{refreshData}" styleClass="refresh-btn" />
            </HBox>

            <!-- Metric Cards -->
            <HBox styleClass="cards-grid">
                <!-- Revenue Card -->
                <VBox styleClass="metric-card">
                    <HBox styleClass="card-header">
                        <Box styleClass="card-icon icon-blue">
                            <Label text="💰" />
                        </Box>
                        <Label text="{revenueChangeText}"
                               styleClass="{revenueChangeClass}"
                               color="{revenueChangeColor}" />
                    </HBox>
                    <Label text="{revenueFormatted}" styleClass="card-value" />
                    <Label text="Total Revenue" styleClass="card-label" />
                </VBox>

                <!-- Users Card -->
                <VBox styleClass="metric-card">
                    <HBox styleClass="card-header">
                        <Box styleClass="card-icon icon-green">
                            <Label text="👥" />
                        </Box>
                        <Label text="{usersChangeText}"
                               styleClass="{usersChangeClass}"
                               color="{usersChangeColor}" />
                    </HBox>
                    <Label text="{usersFormatted}" styleClass="card-value" />
                    <Label text="Active Users" styleClass="card-label" />
                </VBox>

                <!-- Orders Card -->
                <VBox styleClass="metric-card">
                    <HBox styleClass="card-header">
                        <Box styleClass="card-icon icon-orange">
                            <Label text="📦" />
                        </Box>
                        <Label text="{ordersChangeText}"
                               styleClass="{ordersChangeClass}"
                               color="{ordersChangeColor}" />
                    </HBox>
                    <Label text="{ordersFormatted}" styleClass="card-value" />
                    <Label text="Total Orders" styleClass="card-label" />
                </VBox>

                <!-- Conversion Card -->
                <VBox styleClass="metric-card">
                    <HBox styleClass="card-header">
                        <Box styleClass="card-icon icon-purple">
                            <Label text="📈" />
                        </Box>
                        <Label text="{conversionChangeText}"
                               styleClass="{conversionChangeClass}"
                               color="{conversionChangeColor}" />
                    </HBox>
                    <Label text="{conversionFormatted}" styleClass="card-value" />
                    <Label text="Conversion Rate" styleClass="card-label" />
                </VBox>
            </HBox>

            <!-- Chart Section -->
            <VBox styleClass="chart-section">
                <Label text="Revenue Overview" styleClass="section-title" />
                <HBox styleClass="chart-placeholder">
                    <Box styleClass="chart-bar" height="40%" />
                    <Box styleClass="chart-bar" height="60%" />
                    <Box styleClass="chart-bar" height="45%" />
                    <Box styleClass="chart-bar" height="80%" />
                    <Box styleClass="chart-bar" height="65%" />
                    <Box styleClass="chart-bar" height="90%" />
                    <Box styleClass="chart-bar" height="75%" />
                    <Box styleClass="chart-bar" height="85%" />
                    <Box styleClass="chart-bar" height="70%" />
                    <Box styleClass="chart-bar" height="95%" />
                    <Box styleClass="chart-bar" height="88%" />
                    <Box styleClass="chart-bar" height="100%" />
                </HBox>
            </VBox>

            <!-- Recent Activity -->
            <VBox styleClass="activity-section">
                <Label text="Recent Activity" styleClass="section-title" />
                <VBox>
                    <HBox styleClass="activity-item">
                        <Box styleClass="activity-dot" backgroundColor="#34c759" />
                        <Label text="New order #1234 received" styleClass="activity-text" />
                        <Label text="2m ago" styleClass="activity-time" />
                    </HBox>
                    <HBox styleClass="activity-item">
                        <Box styleClass="activity-dot" backgroundColor="#007aff" />
                        <Label text="User john@email.com signed up" styleClass="activity-text" />
                        <Label text="15m ago" styleClass="activity-time" />
                    </HBox>
                    <HBox styleClass="activity-item">
                        <Box styleClass="activity-dot" backgroundColor="#ff9500" />
                        <Label text="Payment of $299 processed" styleClass="activity-text" />
                        <Label text="1h ago" styleClass="activity-time" />
                    </HBox>
                    <HBox styleClass="activity-item">
                        <Box styleClass="activity-dot" backgroundColor="#af52de" />
                        <Label text="New review submitted (5 stars)" styleClass="activity-text" />
                        <Label text="2h ago" styleClass="activity-time" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </VBox>

</Application>
