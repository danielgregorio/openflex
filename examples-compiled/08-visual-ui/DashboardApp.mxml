<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Dashboard - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var users: Number = 1247;
        @reactive var revenue: Number = 45678;
        @reactive var orders: Number = 823;
        @reactive var growth: Number = 12.5;
        @reactive var conversion: Number = 3.2;

        @computed var usersFormatted: String {
            return users.toLocaleString('pt-BR');
        }

        @computed var revenueFormatted: String {
            return "R$ " + revenue.toLocaleString('pt-BR', {minimumFractionDigits: 2});
        }

        @computed var ordersFormatted: String {
            return orders.toLocaleString('pt-BR');
        }

        @computed var growthFormatted: String {
            return (growth >= 0 ? '+' : '') + growth.toFixed(1) + '%';
        }

        @computed var growthColor: String {
            return growth >= 0 ? '#10b981' : '#ef4444';
        }

        @computed var conversionFormatted: String {
            return conversion.toFixed(1) + '%';
        }

        function simulateUpdate(): void {
            users += Math.floor(Math.random() * 50 - 10);
            revenue += Math.floor(Math.random() * 5000 - 1000);
            orders += Math.floor(Math.random() * 20 - 5);
            growth = (Math.random() * 30) - 10;
            conversion = 2.5 + (Math.random() * 2);
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('dashboard-styles.css');
    </fx:Style>

    <VBox gap="0" width="100%" height="100%" styleClass="app-container">
        <VBox gap="40" width="100%" style="max-width: 1600px; margin: 0 auto;">

            <!-- Header -->
            <HBox horizontalAlign="space-between" verticalAlign="center" width="100%">
                <VBox gap="8">
                    <Label text="📊 Dashboard Executivo" styleClass="dashboard-title" />
                    <Label text="Visão geral das métricas principais" styleClass="dashboard-subtitle" />
                </VBox>
                <Button label="🔄 Atualizar Dados" click="{simulateUpdate}" styleClass="update-btn" />
            </HBox>

            <!-- KPI Cards Grid -->
            <HBox gap="24" width="100%">
                <!-- Card 1: Usuários -->
                <Panel styleClass="stat-panel">
                    <VBox gap="0">
                        <Label text="👥" styleClass="stat-icon" />
                        <Label text="Usuários Ativos" styleClass="stat-label" />
                        <Label text="{usersFormatted}" styleClass="stat-value" />
                        <Label text="+15% vs mês anterior" styleClass="stat-change positive" />
                    </VBox>
                </Panel>

                <!-- Card 2: Receita -->
                <Panel styleClass="stat-panel">
                    <VBox gap="0">
                        <Label text="💰" styleClass="stat-icon" />
                        <Label text="Receita Total" styleClass="stat-label" />
                        <Label text="{revenueFormatted}" styleClass="stat-value" />
                        <Label text="{growthFormatted}" styleClass="stat-change positive" color="{growthColor}" />
                    </VBox>
                </Panel>

                <!-- Card 3: Pedidos -->
                <Panel styleClass="stat-panel">
                    <VBox gap="0">
                        <Label text="🛒" styleClass="stat-icon" />
                        <Label text="Pedidos" styleClass="stat-label" />
                        <Label text="{ordersFormatted}" styleClass="stat-value" />
                        <Label text="+8% vs mês anterior" styleClass="stat-change positive" />
                    </VBox>
                </Panel>

                <!-- Card 4: Conversão -->
                <Panel styleClass="stat-panel">
                    <VBox gap="0">
                        <Label text="📈" styleClass="stat-icon" />
                        <Label text="Taxa de Conversão" styleClass="stat-label" />
                        <Label text="{conversionFormatted}" styleClass="stat-value" />
                        <Label text="+0.5% vs mês anterior" styleClass="stat-change positive" />
                    </VBox>
                </Panel>
            </HBox>

            <!-- Bottom Section: Chart + Goals -->
            <HBox gap="24" width="100%">
                <!-- Chart Panel -->
                <Panel styleClass="chart-panel">
                    <VBox gap="0" width="100%">
                        <Label text="📊 Vendas dos Últimos 12 Meses" styleClass="section-title" />
                        <Box styleClass="chart-placeholder">
                            <Label text="Gráfico interativo seria renderizado aqui" />
                        </Box>
                    </VBox>
                </Panel>

                <!-- Goals Panel -->
                <Panel styleClass="goals-panel">
                    <VBox gap="0" width="100%">
                        <Label text="🎯 Metas do Mês" styleClass="section-title" />

                        <!-- Goal 1: Vendas -->
                        <VBox gap="0" styleClass="goal-item">
                            <Label text="Vendas" styleClass="goal-name" />
                            <Label text="92%" styleClass="goal-percentage warning" />
                            <Box styleClass="goal-bar-container">
                                <Box styleClass="goal-bar warning" style="width: 92%"></Box>
                            </Box>
                            <Label text="R$ 46.000 de R$ 50.000" styleClass="goal-details" />
                        </VBox>

                        <!-- Goal 2: Usuários -->
                        <VBox gap="0" styleClass="goal-item">
                            <Label text="Novos Usuários" styleClass="goal-name" />
                            <Label text="104%" styleClass="goal-percentage success" />
                            <Box styleClass="goal-bar-container">
                                <Box styleClass="goal-bar success" style="width: 100%"></Box>
                            </Box>
                            <Label text="1.300 de 1.250 usuários" styleClass="goal-details" />
                        </VBox>

                        <!-- Goal 3: Conversão -->
                        <VBox gap="0" styleClass="goal-item">
                            <Label text="Conversão" styleClass="goal-name" />
                            <Label text="89%" styleClass="goal-percentage warning" />
                            <Box styleClass="goal-bar-container">
                                <Box styleClass="goal-bar warning" style="width: 89%"></Box>
                            </Box>
                            <Label text="3.2% de 3.6% meta" styleClass="goal-details" />
                        </VBox>

                    </VBox>
                </Panel>
            </HBox>

        </VBox>
    </VBox>

</Application>
