<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Reminders - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var todos: Array = [
            { id: 1, text: "Buy groceries", completed: false },
            { id: 2, text: "Call mom", completed: true },
            { id: 3, text: "Finish project", completed: false }
        ];
        @reactive var newTodoText: String = "";
        @reactive var filter: String = "all";

        var nextId: Number = 4;

        @computed var filteredTodos: Array {
            if (filter === "active") return todos.filter(t => !t.completed);
            if (filter === "completed") return todos.filter(t => t.completed);
            return todos;
        }

        @computed var activeCount: Number {
            return todos.filter(t => !t.completed).length;
        }

        @computed var completedCount: Number {
            return todos.filter(t => t.completed).length;
        }

        function addTodo(): void {
            if (newTodoText.trim() === "") return;
            todos = [...todos, {
                id: nextId++,
                text: newTodoText.trim(),
                completed: false
            }];
            newTodoText = "";
        }

        function toggleTodo(id: Number): void {
            todos = todos.map(todo =>
                todo.id === id ? {...todo, completed: !todo.completed} : todo
            );
        }

        function deleteTodo(id: Number): void {
            todos = todos.filter(t => t.id !== id);
        }

        function clearCompleted(): void {
            todos = todos.filter(t => !t.completed);
        }

        function handleKeyPress(event): void {
            if (event.key === "Enter") addTodo();
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./todo-list-app.css');
    </fx:Style>

    <VBox styleClass="todo-container">
        <VBox styleClass="todo-app">
            <!-- Header -->
            <VBox styleClass="header">
                <Label text="Reminders" styleClass="header-title" />
                <Label text="{activeCount + ' remaining'}" styleClass="header-subtitle" />
            </VBox>

            <!-- Input -->
            <HBox styleClass="input-section">
                <TextInput placeholder="Add a new task..."
                           value="{newTodoText}"
                           keyPress="{handleKeyPress}"
                           styleClass="todo-input" />
                <Button label="+" click="{addTodo}" styleClass="add-btn" />
            </HBox>

            <!-- Filters -->
            <HBox styleClass="filter-row">
                <Button label="All" click="{() => filter = 'all'}"
                        styleClass="filter-btn {filter === 'all' ? 'filter-btn-active' : ''}" />
                <Button label="Active" click="{() => filter = 'active'}"
                        styleClass="filter-btn {filter === 'active' ? 'filter-btn-active' : ''}" />
                <Button label="Done" click="{() => filter = 'completed'}"
                        styleClass="filter-btn {filter === 'completed' ? 'filter-btn-active' : ''}" />
            </HBox>

            <!-- Todo List -->
            <VBox styleClass="todo-list">
                <Label text="No tasks yet" styleClass="empty-state"
                       visible="{filteredTodos.length === 0}" />

                <Repeater dataProvider="{filteredTodos}">
                    <HBox styleClass="todo-item">
                        <Button label="{item.completed ? '✓' : ''}"
                                click="{() => toggleTodo(item.id)}"
                                styleClass="todo-checkbox {item.completed ? 'todo-checkbox-done' : ''}" />
                        <Label text="{item.text}"
                               styleClass="todo-text {item.completed ? 'todo-text-done' : ''}" />
                        <Button label="×" click="{() => deleteTodo(item.id)}"
                                styleClass="delete-btn" />
                    </HBox>
                </Repeater>
            </VBox>

            <!-- Footer -->
            <HBox styleClass="footer" visible="{todos.length > 0}">
                <Label text="{todos.length + ' total, ' + completedCount + ' done'}"
                       styleClass="footer-text" />
                <Button label="Clear Done" click="{clearCompleted}"
                        styleClass="clear-btn" visible="{completedCount > 0}" />
            </HBox>
        </VBox>
    </VBox>

</Application>
