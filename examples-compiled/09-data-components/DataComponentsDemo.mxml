<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Data Components - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var employees: Array = [
            {id: 1, name: 'Sarah Chen', role: 'Engineer', salary: 95000, status: 'active'},
            {id: 2, name: 'Marcus Johnson', role: 'Designer', salary: 82000, status: 'active'},
            {id: 3, name: 'Emily Davis', role: 'Manager', salary: 110000, status: 'away'},
            {id: 4, name: 'Alex Rivera', role: 'Engineer', salary: 88000, status: 'active'},
            {id: 5, name: 'Jordan Lee', role: 'Marketing', salary: 75000, status: 'active'}
        ];

        @reactive var activities: Array = [
            {icon: '✅', text: 'Sarah completed Sprint 24', time: '2m'},
            {icon: '📊', text: 'Marcus uploaded new designs', time: '15m'},
            {icon: '💬', text: 'Emily added 3 comments', time: '1h'},
            {icon: '🚀', text: 'Alex deployed to production', time: '2h'}
        ];

        @reactive var selectedEmployee: Number = -1;
        @reactive var filter: String = 'all';

        @computed var filteredEmployees: Array {
            if (filter === 'all') return employees;
            return employees.filter(e => e.status === filter);
        }

        @computed var totalSalary: Number {
            return employees.reduce((sum, e) => sum + e.salary, 0);
        }

        @computed var avgSalary: Number {
            return Math.round(totalSalary / employees.length);
        }

        @computed var activeCount: Number {
            return employees.filter(e => e.status === 'active').length;
        }

        function addEmployee(): void {
            const names = ['Chris', 'Taylor', 'Morgan', 'Casey', 'Jamie'];
            const roles = ['Engineer', 'Designer', 'Manager', 'Marketing'];
            const name = names[Math.floor(Math.random() * names.length)] + ' ' +
                        String.fromCharCode(65 + Math.floor(Math.random() * 26)) + '.';
            employees = [...employees, {
                id: employees.length + 1,
                name: name,
                role: roles[Math.floor(Math.random() * roles.length)],
                salary: 70000 + Math.floor(Math.random() * 40000),
                status: 'active'
            }];
        }

        function removeEmployee(id: Number): void {
            employees = employees.filter(e => e.id !== id);
        }

        function toggleStatus(id: Number): void {
            employees = employees.map(e =>
                e.id === id ? {...e, status: e.status === 'active' ? 'away' : 'active'} : e
            );
        }

        function selectEmployee(index: Number): void {
            selectedEmployee = selectedEmployee === index ? -1 : index;
        }

        function getStatusClass(status: String): String {
            return status === 'active' ? 'badge-green' : 'badge-orange';
        }

        function formatSalary(amount: Number): String {
            return '$' + amount.toLocaleString();
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./data-components-demo.css');
    </fx:Style>

    <VBox styleClass="app">
        <VBox styleClass="wrapper">
            <!-- Header -->
            <VBox styleClass="header">
                <Label text="Data Components" styleClass="title" />
                <Label text="DataGrid, List and dynamic data binding" styleClass="subtitle" />
            </VBox>

            <!-- Stats -->
            <HBox styleClass="stats">
                <VBox styleClass="stat">
                    <Label text="{employees.length}" styleClass="stat-value" />
                    <Label text="Employees" styleClass="stat-label" />
                </VBox>
                <VBox styleClass="stat">
                    <Label text="{activeCount}" styleClass="stat-value" color="#34c759" />
                    <Label text="Active" styleClass="stat-label" />
                </VBox>
                <VBox styleClass="stat">
                    <Label text="{formatSalary(avgSalary)}" styleClass="stat-value" />
                    <Label text="Avg Salary" styleClass="stat-label" />
                </VBox>
                <VBox styleClass="stat">
                    <Label text="{formatSalary(totalSalary)}" styleClass="stat-value" color="#5856d6" />
                    <Label text="Total Payroll" styleClass="stat-label" />
                </VBox>
            </HBox>

            <!-- Main Grid -->
            <HBox styleClass="grid">
                <!-- DataGrid Card -->
                <VBox styleClass="card">
                    <Label text="Employee Directory" styleClass="card-title" />

                    <HBox styleClass="controls">
                        <Button label="+ Add Employee" click="{addEmployee}" styleClass="btn btn-primary" />
                    </HBox>

                    <HBox styleClass="filter-tabs">
                        <Button label="All" click="{() => filter = 'all'}"
                                styleClass="filter-tab {filter === 'all' ? 'filter-tab-active' : ''}" />
                        <Button label="Active" click="{() => filter = 'active'}"
                                styleClass="filter-tab {filter === 'active' ? 'filter-tab-active' : ''}" />
                        <Button label="Away" click="{() => filter = 'away'}"
                                styleClass="filter-tab {filter === 'away' ? 'filter-tab-active' : ''}" />
                    </HBox>

                    <VBox styleClass="datagrid">
                        <HBox styleClass="datagrid-header">
                            <Label text="Name" styleClass="cell" />
                            <Label text="Role" styleClass="cell cell-sm" />
                            <Label text="Salary" styleClass="cell cell-sm" />
                            <Label text="Status" styleClass="cell cell-sm" />
                            <Label text="" style="width: 70px;" />
                        </HBox>

                        <Repeater dataProvider="{filteredEmployees}">
                            <HBox styleClass="datagrid-row {selectedEmployee === index ? 'datagrid-row-selected' : ''}"
                                  click="{() => selectEmployee(index)}">
                                <Label text="{item.name}" styleClass="cell cell-name" />
                                <Label text="{item.role}" styleClass="cell cell-sm" />
                                <Label text="{formatSalary(item.salary)}" styleClass="cell cell-sm" />
                                <Label text="{item.status === 'active' ? 'Active' : 'Away'}"
                                       styleClass="cell cell-sm badge {getStatusClass(item.status)}" />
                                <HBox styleClass="actions">
                                    <Button label="⟳" click="{() => toggleStatus(item.id)}" styleClass="action-btn" />
                                    <Button label="×" click="{() => removeEmployee(item.id)}" styleClass="action-btn action-btn-delete" />
                                </HBox>
                            </HBox>
                        </Repeater>
                    </VBox>
                </VBox>

                <!-- Activity List Card -->
                <VBox styleClass="card">
                    <Label text="Recent Activity" styleClass="card-title" />

                    <VBox styleClass="activity-list">
                        <Repeater dataProvider="{activities}">
                            <HBox styleClass="activity-item">
                                <Box styleClass="activity-icon">
                                    <Label text="{item.icon}" />
                                </Box>
                                <VBox styleClass="activity-content">
                                    <Label text="{item.text}" styleClass="activity-text" />
                                    <Label text="{item.time + ' ago'}" styleClass="activity-time" />
                                </VBox>
                            </HBox>
                        </Repeater>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>

</Application>
