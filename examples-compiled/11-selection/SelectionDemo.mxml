<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Selection Demo - OpenFlex Neo">

    <fx:Script><![CDATA[
        @reactive var fruits: Array = [
            {label: 'Apple', emoji: '🍎', color: 'Red'},
            {label: 'Banana', emoji: '🍌', color: 'Yellow'},
            {label: 'Cherry', emoji: '🍒', color: 'Red'},
            {label: 'Grape', emoji: '🍇', color: 'Purple'},
            {label: 'Orange', emoji: '🍊', color: 'Orange'}
        ];

        @reactive var employees: Array = [
            {name: 'Sarah Chen', role: 'Engineer', salary: 95000, status: 'active'},
            {name: 'Marcus Johnson', role: 'Designer', salary: 82000, status: 'active'},
            {name: 'Emily Davis', role: 'Manager', salary: 110000, status: 'away'},
            {name: 'Alex Rivera', role: 'Marketing', salary: 75000, status: 'active'}
        ];

        @reactive var selectedFruit: Number = -1;
        @reactive var selectedEmployee: Number = -1;
        @reactive var lastAction: String = 'Click an item to select';

        function onFruitChange(event): void {
            lastAction = 'Selected fruit: ' + fruits[event.index].label;
        }

        function onEmployeeChange(event): void {
            lastAction = 'Selected employee: ' + employees[event.index].name;
        }

        function onEmployeeDoubleClick(event): void {
            lastAction = 'Double-clicked: ' + event.item.name + ' - Salary: $' + event.item.salary.toLocaleString();
        }

        function selectFruit(index): void {
            selectedFruit = index;
            lastAction = 'Selected fruit: ' + fruits[index].label;
        }

        function selectEmployee(index): void {
            selectedEmployee = index;
            lastAction = 'Selected employee: ' + employees[index].name;
        }

        function getSelectedClass(currentIndex, selectedIndex): String {
            return currentIndex === selectedIndex ? 'item-selected' : '';
        }

        function formatSalary(amount): String {
            return '$' + amount.toLocaleString();
        }

        function getStatusClass(status): String {
            return status === 'active' ? 'badge-green' : 'badge-orange';
        }

        @computed var selectedFruitInfo: String {
            if (selectedFruit >= 0) {
                var f = fruits[selectedFruit];
                return f.emoji + ' ' + f.label + ' (' + f.color + ')';
            }
            return 'None selected';
        }

        @computed var selectedEmployeeInfo: String {
            if (selectedEmployee >= 0) {
                var e = employees[selectedEmployee];
                return e.name + ' - ' + e.role;
            }
            return 'None selected';
        }
    ]]></fx:Script>

    <fx:Style>
        @import url('./selection-demo.css');
    </fx:Style>

    <VBox styleClass="app">
        <VBox styleClass="wrapper">
            <!-- Header -->
            <VBox styleClass="header">
                <Label text="Selection Demo" styleClass="title" />
                <Label text="Click items to select. Double-click employees to see salary." styleClass="subtitle" />
            </VBox>

            <!-- Grid -->
            <HBox styleClass="grid">
                <!-- Fruits List -->
                <VBox styleClass="card">
                    <VBox styleClass="card-header">
                        <Label text="Fruits List" styleClass="card-title" />
                        <Label text="Single selection mode" styleClass="card-subtitle" />
                    </VBox>
                    <VBox styleClass="list-items">
                        <Repeater dataProvider="{fruits}">
                            <HBox styleClass="fruit-item {index === selectedFruit ? 'item-selected' : ''}"
                                  click="{() => selectFruit(index)}">
                                <Label text="{item.emoji}" styleClass="fruit-emoji" />
                                <VBox styleClass="fruit-info">
                                    <Label text="{item.label}" styleClass="fruit-name" />
                                    <Label text="{item.color}" styleClass="fruit-color" />
                                </VBox>
                                <Label text="✓" styleClass="check-icon" />
                            </HBox>
                        </Repeater>
                    </VBox>
                    <HBox styleClass="selection-info">
                        <Label text="Selected:" styleClass="selection-label" />
                        <Label text="{selectedFruitInfo}" styleClass="selection-value" />
                    </HBox>
                </VBox>

                <!-- Employees DataGrid -->
                <VBox styleClass="card">
                    <VBox styleClass="card-header">
                        <Label text="Employees DataGrid" styleClass="card-title" />
                        <Label text="Double-click for details" styleClass="card-subtitle" />
                    </VBox>
                    <VBox styleClass="datagrid">
                        <HBox styleClass="datagrid-header">
                            <Label text="Name" styleClass="datagrid-header-cell" />
                            <Label text="Role" styleClass="datagrid-header-cell" />
                            <Label text="Status" styleClass="datagrid-header-cell" />
                        </HBox>
                        <Repeater dataProvider="{employees}">
                            <HBox styleClass="datagrid-row {index === selectedEmployee ? 'item-selected' : ''}"
                                  click="{() => selectEmployee(index)}">
                                <Label text="{item.name}" styleClass="datagrid-cell cell-name" />
                                <Label text="{item.role}" styleClass="datagrid-cell" />
                                <Label text="{item.status === 'active' ? 'Active' : 'Away'}"
                                       styleClass="datagrid-cell badge {item.status === 'active' ? 'badge-green' : 'badge-orange'}" />
                            </HBox>
                        </Repeater>
                    </VBox>
                    <HBox styleClass="selection-info">
                        <Label text="Selected:" styleClass="selection-label" />
                        <Label text="{selectedEmployeeInfo}" styleClass="selection-value" />
                    </HBox>
                </VBox>
            </HBox>

            <!-- Status Bar -->
            <HBox styleClass="status-bar">
                <Label text="📋" styleClass="status-icon" />
                <Label text="Last Action:" styleClass="status-label" />
                <Label text="{lastAction}" styleClass="status-text" />
            </HBox>
        </VBox>
    </VBox>

</Application>
