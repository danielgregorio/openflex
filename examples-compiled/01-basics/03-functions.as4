// Funções - Exemplo de declaração e uso de funções

// Função simples
function greet(name: String): String {
    return "Olá, " + name + "!";
}

// Função com múltiplos parâmetros
function add(a: Number, b: Number): Number {
    return a + b;
}

// Função para multiplicar
function multiply(a: Number, b: Number): Number {
    return a * b;
}

function main(): void {
    trace(greet("OpenFlex"));

    const sum: Number = add(2, 3);
    trace("2 + 3 = " + sum);

    const product: Number = multiply(5, 2);
    trace("5 * 2 = " + product);

    const product2: Number = multiply(5, 3);
    trace("5 * 3 = " + product2);
}

main();
