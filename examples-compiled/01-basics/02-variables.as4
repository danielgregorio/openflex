// Variáveis e Tipos - Exemplo de declaração de variáveis

function main(): void {
    // Tipos básicos
    const name: String = "OpenFlex";
    const version: Number = 4;
    const isReady: Boolean = true;

    // Arrays
    const lang1: String = "ActionScript";
    const lang2: String = "JavaScript";
    const lang3: String = "TypeScript";

    // Imprimir valores
    trace("Nome:", name);
    trace("Versão:", version);
    trace("Pronto:", isReady);
    trace("Linguagens:", lang1, lang2, lang3);
}

main();
