{
  "name": "ActionScript 4",
  "scopeName": "source.actionscript4",
  "fileTypes": ["as4"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.as4",
          "match": "//.*$"
        },
        {
          "name": "comment.block.as4",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.as4",
          "match": "@(reactive|computed|effect|observable)\\b",
          "captures": {
            "1": { "name": "entity.name.function.decorator.as4" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.as4",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|throw|try|catch|finally|async|await)\\b"
        },
        {
          "name": "keyword.other.as4",
          "match": "\\b(import|package|extends|implements|interface|class|function|var|const|let|new|this|super|static|public|private|protected|internal|override|final|native|get|set)\\b"
        },
        {
          "name": "keyword.operator.as4",
          "match": "\\b(typeof|instanceof|in|is|as|delete)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.as4",
          "match": "\\b(void|int|uint|Number|String|Boolean|Array|Object|Function|Class|Date|RegExp|XML|XMLList|Dictionary|Vector)\\b"
        },
        {
          "name": "storage.type.nullable.as4",
          "match": "\\?\\s*(\\w+)",
          "captures": {
            "1": { "name": "storage.type.as4" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.as4",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.as4",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.as4",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.as4",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.as4",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.as4",
          "match": "\\b\\d+\\.?\\d*([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.as4",
          "match": "\\b(function)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.as4" },
            "2": { "name": "entity.name.function.as4" }
          }
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "meta.class.as4",
          "match": "\\b(class|interface)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": { "name": "storage.type.class.as4" },
            "2": { "name": "entity.name.type.class.as4" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.as4",
          "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "constant.other.as4",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.as4",
          "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|>>>="
        },
        {
          "name": "keyword.operator.comparison.as4",
          "match": "==|!=|===|!==|<|>|<=|>="
        },
        {
          "name": "keyword.operator.logical.as4",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.as4",
          "match": "\\+|-|\\*|/|%|\\+\\+|--"
        },
        {
          "name": "keyword.operator.optional.as4",
          "match": "\\?\\.|\\?\\?"
        }
      ]
    }
  }
}
