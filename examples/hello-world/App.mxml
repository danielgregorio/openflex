<?xml version="1.0" encoding="utf-8"?>
<Application
    xmlns:fx="http://openflex.dev/core"
    xmlns="http://openflex.dev/neo"
    title="Hello World - OpenFlex Neo">

    <fx:Script>
        // Neo - Clean, simple, reactive
        @reactive var message: String = "Hello, OpenFlex Neo!";
        @reactive var year: Number = 2025;

        function greet(): void {
            trace(message + " - " + year);
        }
    </fx:Script>

    <!-- Neo components (no prefix needed!) -->
    <VBox gap={16} horizontalAlign="center" verticalAlign="middle" width="100%" height="100%">
        <Label text={message} fontSize={32} fontWeight="bold" />
        <Label text="Welcome to the future of ActionScript" fontSize={16} />
        <Label text="Built with Neo 🆕" fontSize={14} color="#666" />
        <Button label="Click Me" click={greet} />
    </VBox>

</Application>
