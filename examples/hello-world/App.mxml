<?xml version="1.0" encoding="utf-8"?>
<s:Application xmlns:fx="http://ns.adobe.com/mxml/2009"
               xmlns:s="library://ns.adobe.com/flex/spark">

    <fx:Script>
        var message: String = "Hello, OpenFlex!";
        var year: Number = 2025;

        function greet(): void {
            trace(message + " - " + year);
        }
    </fx:Script>

    <s:VBox gap="16" horizontalAlign="center" verticalAlign="middle">
        <s:Label text="{message}" fontSize="32" fontWeight="bold" />
        <s:Label text="Welcome to the future of ActionScript" fontSize="16" />
        <s:Button label="Click Me" click="greet()" />
    </s:VBox>

</s:Application>
