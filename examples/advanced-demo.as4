trace("Dog Buddy says: Woof!");
trace("Buddy is 3 years old");
trace("Buddy is fetching the ball!");
trace("");

// Test control flow
trace("--- Control Flow ---");
trace("Score 95: Grade " + calculateGrade(95));
trace("Score 85: Grade " + calculateGrade(85));
trace("Score 75: Grade " + calculateGrade(75));
trace("Score 65: Grade " + calculateGrade(65));
trace("Score 55: Grade " + calculateGrade(55));
trace("");

// Test fibonacci
trace("--- Advanced Algorithms ---");
trace("Fibonacci(0) = " + fibonacci(0));
trace("Fibonacci(1) = " + fibonacci(1));
trace("Fibonacci(5) = " + fibonacci(5));
trace("Fibonacci(10) = " + fibonacci(10));
trace("");

