trace(createUser("Diana", 25));          // User: Diana, Age: 25, Active: true
trace(createUser("Eve", 30, false));     // User: Eve, Age: 30, Active: false
trace("");

// Test classes and inheritance
trace("--- Classes & Inheritance ---");
