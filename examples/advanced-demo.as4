// Advanced OpenFlex Neo Demo
// Showcasing ALL working features including new ones!

// ============================================================================
// 1. Classes with Properties and Inheritance
// ============================================================================

class Animal {
    var name: String;
    var age: Number;

    function makeSound(): String {
        return "Some generic sound";
    }

    function describe(): String {
        return name + " is " + age + " years old";
    }
}

class Dog extends Animal {
    var breed: String;

    function makeSound(): String {
        return "Woof!";
    }

    function fetch(): String {
        return name + " is fetching the ball!";
    }
}

// ============================================================================
// 2. Functions with Default Parameters
// ============================================================================

function greet(name: String = "World", greeting: String = "Hello"): String {
    return greeting + ", " + name + "!";
}

function createUser(name: String, age: Number = 18, active: Boolean = true): String {
    return "User: " + name + ", Age: " + age + ", Active: " + active;
}

// ============================================================================
// 3. Complex Control Flow
// ============================================================================

function calculateGrade(score: Number): String {
    if (score >= 90) {
        return "A";
    } else if (score >= 80) {
        return "B";
    } else if (score >= 70) {
        return "C";
    } else if (score >= 60) {
        return "D";
    } else {
        return "F";
    }
}

// ============================================================================
// 4. Advanced Loops
// ============================================================================

function fibonacci(n: Number): Number {
    if (n <= 1) {
        return n;
    }

    var a: Number = 0;
    var b: Number = 1;
    var temp: Number = 0;

    for (var i: Number = 2; i <= n; i++) {
        temp = a + b;
        a = b;
        b = temp;
    }

    return b;
}

function countdown(from: Number): void {
    while (from > 0) {
        trace(from);
        from = from - 1;
    }
}

// ============================================================================
// 5. Object-Oriented Demo
// ============================================================================

class Calculator {
    var memory: Number;

    function add(a: Number, b: Number = 0): Number {
        return a + b;
    }

    function multiply(a: Number, b: Number = 1): Number {
        return a * b;
    }

    function power(base: Number, exponent: Number = 2): Number {
        var result: Number = 1;
        for (var i: Number = 0; i < exponent; i++) {
            result = result * base;
        }
        return result;
    }

    function storeInMemory(value: Number): void {
        memory = value;
    }

    function recall(): Number {
        return memory;
    }
}

// ============================================================================
// 6. Main Program
// ============================================================================

trace("=== Advanced OpenFlex Neo Demo ===");
trace("");

// Test default parameters
trace("--- Default Parameters ---");
trace(greet());                           // Hello, World!
